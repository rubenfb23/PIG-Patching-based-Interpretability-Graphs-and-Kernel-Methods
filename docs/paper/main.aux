\newlabel{tab:config}{{1}{6}{Experimental configuration. All results use residual-stream-only nodes unless otherwise noted}{table.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Main Results: $n=100$ with Example-Disjoint Split}{6}{subsection.4.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Graph representation results on IOI with GPT-2 ($n=100$ prompt pairs per corruption, example-disjoint bootstrap split, seeds $\{7,42,123\}$). Edge features use residual-stream-only nodes with $k=5$. Fixed-layout signed preserves localized edge-slot information best among graph representations, while global spectral and graphlet summaries discard much of the signal.}}{7}{table.2}\protected@file@percent }
\newlabel{tab:main}{{2}{7}{Graph representation results on IOI with GPT-2 ($n=100$ prompt pairs per corruption, example-disjoint bootstrap split, seeds $\{7,42,123\}$). Edge features use residual-stream-only nodes with $k=5$. Fixed-layout signed preserves localized edge-slot information best among graph representations, while global spectral and graphlet summaries discard much of the signal}{table.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Compression trade-offs, non-graph baselines, and null controls on IOI ($n=100$, seeds $\{7,42,123\}$). Raw patch-effect and top-$k$ node rows are per-example diagnostic upper bounds showing that classification signal is already present before graph construction; they are not graph-bootstrap results. Scalable graph compressions preserve much of this localized signal while reducing dimensionality. Null controls show that fixed-layout performance depends on preserving signed node/edge identities.}}{7}{table.3}\protected@file@percent }
\newlabel{tab:baselines}{{3}{7}{Compression trade-offs, non-graph baselines, and null controls on IOI ($n=100$, seeds $\{7,42,123\}$). Raw patch-effect and top-$k$ node rows are per-example diagnostic upper bounds showing that classification signal is already present before graph construction; they are not graph-bootstrap results. Scalable graph compressions preserve much of this localized signal while reducing dimensionality. Null controls show that fixed-layout performance depends on preserving signed node/edge identities}{table.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Scalable Representations}{7}{subsection.4.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Scalable graph representations on IOI. Hashed fixed-layout and coarse count recover most of the fixed-layout signed performance with dimensionality independent of the number of possible edge slots.}}{8}{table.4}\protected@file@percent }
\newlabel{tab:scalable}{{4}{8}{Scalable graph representations on IOI. Hashed fixed-layout and coarse count recover most of the fixed-layout signed performance with dimensionality independent of the number of possible edge slots}{table.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}Pilot Causal Check}{8}{subsection.4.4}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Pilot causal check: proposed vs random vs low-ranked edges ($20$ edges, $20$ prompt pairs, seed $42$). Top-ranked edges show higher influence ($I$) and mediation ($M$) scores than random or low-ranked edges, consistent with the correlational proposals from the graph construction. These results are from a single seed and should be interpreted as preliminary. The $I$ metric measures direct activation-level influence; the $M$ metric measures output-level mediation.}}{8}{table.5}\protected@file@percent }
\newlabel{tab:causal_validation}{{5}{8}{Pilot causal check: proposed vs random vs low-ranked edges ($20$ edges, $20$ prompt pairs, seed $42$). Top-ranked edges show higher influence ($I$) and mediation ($M$) scores than random or low-ranked edges, consistent with the correlational proposals from the graph construction. These results are from a single seed and should be interpreted as preliminary. The $I$ metric measures direct activation-level influence; the $M$ metric measures output-level mediation}{table.5}{}}
