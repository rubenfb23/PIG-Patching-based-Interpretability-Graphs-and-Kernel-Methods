\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Main Results: $n=100$ with Example-Disjoint Split}{6}{subsection.4.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Graph representation results on IOI with GPT-2 ($n=100$ prompt pairs per corruption, example-disjoint bootstrap split, seeds $\{7,42,123\}$). Edge features use residual-stream-only nodes with $k=5$. Fixed-layout signed preserves localized edge-slot information best among graph representations, while global spectral and graphlet summaries discard much of the signal.}}{7}{table.2}\protected@file@percent }
\newlabel{tab:main}{{2}{7}{Graph representation results on IOI with GPT-2 ($n=100$ prompt pairs per corruption, example-disjoint bootstrap split, seeds $\{7,42,123\}$). Edge features use residual-stream-only nodes with $k=5$. Fixed-layout signed preserves localized edge-slot information best among graph representations, while global spectral and graphlet summaries discard much of the signal}{table.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Compression trade-offs and strict null controls on IOI ($n=100$, seeds $\{7,42,123\}$). Scalable graph compressions preserve much of the fixed-layout signed signal while reducing dimensionality. Test-time null controls show that fixed-layout weighted performance falls to chance when edge positions or weight assignments are destroyed.}}{7}{table.3}\protected@file@percent }
\newlabel{tab:baselines}{{3}{7}{Compression trade-offs and strict null controls on IOI ($n=100$, seeds $\{7,42,123\}$). Scalable graph compressions preserve much of the fixed-layout signed signal while reducing dimensionality. Test-time null controls show that fixed-layout weighted performance falls to chance when edge positions or weight assignments are destroyed}{table.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Scalable Representations}{7}{subsection.4.3}\protected@file@percent }
\citation{olsson2022context}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Scalable graph representations on IOI. Hashed fixed-layout and coarse count recover most of the fixed-layout signed performance with dimensionality independent of the number of possible edge slots. The saturated $n=500$ results should be interpreted together with the surface-cue diagnostic in Section~\ref {sec:surface_cue_diagnostic}.}}{8}{table.4}\protected@file@percent }
\newlabel{tab:scalable}{{4}{8}{Scalable graph representations on IOI. Hashed fixed-layout and coarse count recover most of the fixed-layout signed performance with dimensionality independent of the number of possible edge slots. The saturated $n=500$ results should be interpreted together with the surface-cue diagnostic in Section~\ref {sec:surface_cue_diagnostic}}{table.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}Cross-Model Diagnostic: Distilled GPT-2}{8}{subsection.4.4}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Graph representations on IOI with distilled GPT-2 ($n=100$, seeds $\{7,42,123\}$). Fixed-layout and hashed features saturate while shape summaries remain much weaker. The prompt-only surface-cue control also saturates, so $1.0000$ accuracies in this table should be treated as benchmark saturation, not causal proof. Non-graph diagnostics are listed separately as they do not operate on graph representations.}}{8}{table.5}\protected@file@percent }
\newlabel{tab:distilgpt2}{{5}{8}{Graph representations on IOI with distilled GPT-2 ($n=100$, seeds $\{7,42,123\}$). Fixed-layout and hashed features saturate while shape summaries remain much weaker. The prompt-only surface-cue control also saturates, so $1.0000$ accuracies in this table should be treated as benchmark saturation, not causal proof. Non-graph diagnostics are listed separately as they do not operate on graph representations}{table.5}{}}
