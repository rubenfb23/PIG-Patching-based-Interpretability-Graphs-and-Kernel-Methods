\citation{wang2023localizing,nanda2023attribution}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Causal validation: proposed vs random vs low-ranked edges ($20$ edges, $20$ prompt pairs, seed $42$). Top-ranked edges show substantially higher influence ($I$) and mediation ($M$) scores than random or low-ranked edges, consistent with the correlational proposals from the graph construction. These results are from a pilot evaluation on a single seed and should be interpreted as preliminary. The $I$ metric measures direct activation-level influence; the $M$ metric measures output-level mediation.}}{9}{table.5}\protected@file@percent }
\newlabel{tab:causal_validation}{{5}{9}{Causal validation: proposed vs random vs low-ranked edges ($20$ edges, $20$ prompt pairs, seed $42$). Top-ranked edges show substantially higher influence ($I$) and mediation ($M$) scores than random or low-ranked edges, consistent with the correlational proposals from the graph construction. These results are from a pilot evaluation on a single seed and should be interpreted as preliminary. The $I$ metric measures direct activation-level influence; the $M$ metric measures output-level mediation}{table.5}{}}
