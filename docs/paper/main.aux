\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Feature dimensionality as the analyzed internal node set grows. The fixed-layout representation scales as $N(N-1)$, where $N$ is the number of analyzed layer--token--component nodes. Raw patch-effect vectors grow linearly in $N$, while hashed fixed-layout, coarse count, spectral, and graphlet representations remain fixed-dimensional under the configurations used in this study.}}{11}{figure.1}\protected@file@percent }
\newlabel{fig:compression_scaling}{{1}{11}{Feature dimensionality as the analyzed internal node set grows. The fixed-layout representation scales as $N(N-1)$, where $N$ is the number of analyzed layer--token--component nodes. Raw patch-effect vectors grow linearly in $N$, while hashed fixed-layout, coarse count, spectral, and graphlet representations remain fixed-dimensional under the configurations used in this study}{figure.1}{}}
\citation{nanda2023attribution}
\citation{wang2023localizing}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Feature-budget sweep for compressed graph representations on cached GPT-2 IOI patch-effect tensors ($n=100$, $k=5$, seeds $\{7,42,123\}$). Lines denote representations with multiple tested budgets; single markers denote canonical fixed-budget summaries. Hashed fixed-layout is the only compressed family in this sweep that reaches $95\%$ of fixed-layout signed accuracy; spectral and graphlet shape features remain far below the recovery threshold.}}{12}{figure.2}\protected@file@percent }
\newlabel{fig:feature_budget_sweep}{{2}{12}{Feature-budget sweep for compressed graph representations on cached GPT-2 IOI patch-effect tensors ($n=100$, $k=5$, seeds $\{7,42,123\}$). Lines denote representations with multiple tested budgets; single markers denote canonical fixed-budget summaries. Hashed fixed-layout is the only compressed family in this sweep that reaches $95\%$ of fixed-layout signed accuracy; spectral and graphlet shape features remain far below the recovery threshold}{figure.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Feature-budget sweep on cached GPT-2 IOI tensors. Mean recovery is measured relative to fixed-layout signed accuracy on the same seed and split. $d_{95}$ is the smallest feature dimension reaching at least $95\%$ recovery; ``--'' indicates that the representation does not reach the threshold in the tested budget range.}}{12}{table.7}\protected@file@percent }
\newlabel{tab:feature_budget_sweep}{{7}{12}{Feature-budget sweep on cached GPT-2 IOI tensors. Mean recovery is measured relative to fixed-layout signed accuracy on the same seed and split. $d_{95}$ is the smallest feature dimension reaching at least $95\%$ recovery; ``--'' indicates that the representation does not reach the threshold in the tested budget range}{table.7}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.7}Circuit Localization Validation}{12}{subsection.5.7}\protected@file@percent }
\newlabel{sec:circuit_localization}{{5.7}{12}{Circuit Localization Validation}{subsection.5.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Circuit overlap metrics for fixed-layout signed representation. Precision@k is the fraction of top-$k$ nodes matching known IOI circuit positions. Enrichment is the ratio of observed precision to mean precision from 100 random node samplings. Overlap is approximate: circuit positions are layer-level from literature, while our nodes are $(\ell , t)$-level.}}{13}{table.8}\protected@file@percent }
\newlabel{tab:circuit_overlap}{{8}{13}{Circuit overlap metrics for fixed-layout signed representation. Precision@k is the fraction of top-$k$ nodes matching known IOI circuit positions. Enrichment is the ratio of observed precision to mean precision from 100 random node samplings. Overlap is approximate: circuit positions are layer-level from literature, while our nodes are $(\ell , t)$-level}{table.8}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.8}Held-Out Generalization}{13}{subsection.5.8}\protected@file@percent }
\newlabel{sec:held_out}{{5.8}{13}{Held-Out Generalization}{subsection.5.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Held-out generalization results. Mean accuracy across all held-out splits and seeds $\{7, 42, 123\}$. Fixed-layout and hashed representations generalize well; shape descriptors drop to near-chance.}}{14}{table.9}\protected@file@percent }
\newlabel{tab:held_out}{{9}{14}{Held-out generalization results. Mean accuracy across all held-out splits and seeds $\{7, 42, 123\}$. Fixed-layout and hashed representations generalize well; shape descriptors drop to near-chance}{table.9}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.9}Additional Null Controls}{14}{subsection.5.9}\protected@file@percent }
\newlabel{sec:additional_null}{{5.9}{14}{Additional Null Controls}{subsection.5.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Additional null controls for fixed-layout weighted baseline. Most controls reduce accuracy to chance ($\approx 0.50$), confirming that classification depends on structured patch-effect co-variation. The sign flip control does not drop to chance, suggesting that the magnitude of patch effects carries some signal even when signs are randomized.}}{14}{table.10}\protected@file@percent }
\newlabel{tab:additional_null}{{10}{14}{Additional null controls for fixed-layout weighted baseline. Most controls reduce accuracy to chance ($\approx 0.50$), confirming that classification depends on structured patch-effect co-variation. The sign flip control does not drop to chance, suggesting that the magnitude of patch effects carries some signal even when signs are randomized}{table.10}{}}
